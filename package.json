{
  "name": "cleanbook",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "npm --prefix functions install --no-audit --no-fund",
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "preview": "vite preview",
    "preview:demo": "vite preview --mode demo",
    "emulators": "firebase emulators:start --only auth,functions,firestore,storage --project demo-cleanbook",
    "seed": "node scripts/seed.mjs",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only auth,firestore,storage --project demo-cleanbook \"vitest run --config vitest.rules.config.js\""
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "firebase-tools": "^15.33.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.19",
    "vite": "^8.2.0",
    "vitest": "^5.0.3"
  }
}
