rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function canAccess(firmId, clientId) {
      return signedIn()
        && userDoc().data.status == 'active'
        && userDoc().data.firmId == firmId
        && (userDoc().data.role in ['principal', 'manager', 'staff', 'reviewer']
          || clientId in userDoc().data.clientIds);
    }

    match /firms/{firmId}/clients/{clientId}/{allPaths=**} {
      allow read: if canAccess(firmId, clientId);
      allow create: if canAccess(firmId, clientId)
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('(application/pdf|image/.*|text/csv|application/vnd.*)');
      allow update, delete: if canAccess(firmId, clientId)
        && userDoc().data.role in ['principal', 'manager', 'staff'];
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
